---
import Icon from './icons/Icon.astro';

const whatsappUrl =
  'https://wa.me/573146705506?text=Hola,%20me%20gustaría%20saber%20más%20sobre%20tus%20servicios%20de%20desarrollo%20web.';

const projectTypes = ['Sitio web o landing page', 'Aplicación web', 'Backend o API', 'Otro'];

const fieldClass =
  'w-full rounded-lg border border-light-bg bg-primary-dark px-4 py-3 text-white placeholder:text-muted-light/70 focus:border-heading focus:outline-2 focus:outline-offset-2 focus:outline-heading';
const labelClass = 'mb-2 block text-sm font-semibold text-light-text';
---

<section id="contact" class="py-16 md:py-24 bg-gradient-to-br from-primary-dark to-violet-deep fade-in-section">
  <div class="container mx-auto px-4 max-w-6xl">
    <div class="bg-gradient-to-br from-light-bg to-primary-dark rounded-2xl p-6 sm:p-8 md:p-12 shadow-xl">
      <div class="grid gap-10 md:grid-cols-[1fr_1.4fr]">
        <div>
          <h2 class="text-3xl md:text-4xl font-bold mb-6 text-heading">¿Hablamos de tu proyecto?</h2>
          <p class="text-lg text-muted-light mb-8">
            Cuéntame qué necesitas y te responderé por correo con los siguientes pasos.
          </p>
          <p class="text-sm text-muted-light mb-3">¿Prefieres una respuesta más rápida?</p>
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 border border-accent-green text-accent-green py-2.5 px-5 rounded-lg font-semibold transition-colors duration-300 hover:bg-accent-green/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-green"
          >
            <Icon name="whatsapp-logo" class="size-5" />
            Escríbeme por WhatsApp<span class="sr-only"> (se abre en una pestaña nueva)</span>
          </a>
        </div>

        <!-- Netlify Forms detects this form at deploy time; it works without JavaScript. -->
        <form
          name="contact"
          method="POST"
          action="/gracias/"
          data-netlify="true"
          netlify-honeypot="bot-field"
          class="space-y-5"
        >
          <input type="hidden" name="form-name" value="contact" />

          <!-- Honeypot: hidden from people and assistive tech; bots that fill it are discarded. -->
          <p class="hidden" aria-hidden="true">
            <label>
              No completes este campo si eres una persona:
              <input name="bot-field" tabindex="-1" autocomplete="off" />
            </label>
          </p>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="contact-name" class={labelClass}>Nombre</label>
              <input id="contact-name" name="nombre" type="text" required autocomplete="name" maxlength="100" class={fieldClass} />
            </div>
            <div>
              <label for="contact-email" class={labelClass}>Correo electrónico</label>
              <input id="contact-email" name="correo" type="email" required autocomplete="email" maxlength="254" class={fieldClass} />
            </div>
          </div>

          <div>
            <label for="contact-type" class={labelClass}>Tipo de proyecto <span class="font-normal text-muted-light">(opcional)</span></label>
            <select id="contact-type" name="tipo-de-proyecto" class={fieldClass}>
              <option value="">Selecciona una opción</option>
              {projectTypes.map((type) => <option value={type}>{type}</option>)}
            </select>
          </div>

          <div>
            <label for="contact-message" class={labelClass}>Mensaje</label>
            <textarea id="contact-message" name="mensaje" required rows="5" maxlength="2000" class={fieldClass}></textarea>
          </div>

          <button
            type="submit"
            class="inline-flex items-center gap-2 bg-gradient-to-r from-violet-light to-violet-deep text-white py-3 px-8 rounded-lg font-semibold shadow-lg transition-all duration-300 hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-heading"
          >
            Enviar mensaje
            <Icon name="arrow-right" class="size-[1em]" />
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

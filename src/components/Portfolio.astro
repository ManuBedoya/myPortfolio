---
import { getCollection } from 'astro:content';
import ProjectCard from './projects/ProjectCard.astro';

// Only featured projects appear on the home page; `id` breaks ties so the
// order stays stable when two entries share the same `order` value.
const projects = (await getCollection('projects', ({ data }) => data.featured)).sort(
  (a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id),
);

const gridClass =
  projects.length === 1
    ? 'grid-cols-1 max-w-2xl mx-auto'
    : projects.length === 2
      ? 'grid-cols-1 md:grid-cols-2 max-w-5xl mx-auto'
      : 'grid-cols-1 md:grid-cols-2 lg:grid-cols-3';
---

<section id="projects" class="py-16 md:py-24 fade-in-section">
    <div class="container mx-auto px-4 max-w-6xl">
        <h2 class="text-3xl md:text-4xl font-bold mb-12 text-center text-heading">
            Proyectos
        </h2>
        <div class:list={['grid gap-8', gridClass]}>
            {projects.map((project) => <ProjectCard project={project} />)}
        </div>
    </div>
</section>

---
import type { Service, ServiceAccent, ServiceIcon } from '../data/services';

interface Props {
  service: Service;
}

const { service } = Astro.props;

// Stroke-based 24x24 outline icons kept from the original design. They live here
// rather than in Icon.astro because that component renders single-path filled
// Phosphor glyphs on a 256x256 viewBox.
const iconMarkup: Record<ServiceIcon, string> = {
  layers: '<path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>',
  monitor:
    '<rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>',
  home: '<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>',
  api: '<path d="M4 6h16M4 12h16M4 18h16"/><path d="M8 6l4 4-4 4"/><path d="M16 14l-4 4 4 4"/>',
  chart:
    '<line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/>',
  clipboard:
    '<path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/><path d="M9 12h6"/><path d="M9 16h6"/>',
};

const accentClasses: Record<ServiceAccent, { border: string; text: string }> = {
  green: { border: 'border-accent-green', text: 'text-accent-green' },
  blue: { border: 'border-accent-blue', text: 'text-accent-blue' },
};

const accent = accentClasses[service.accent];
---

<article
  class:list={[
    'bg-gradient-to-br from-light-bg to-primary-dark p-8 rounded-xl shadow-md flex flex-col items-center text-center transform hover:scale-105 transition-transform duration-300 border-b-4',
    accent.border,
  ]}
>
  <svg
    class:list={['w-16 h-16 mb-6', accent.text]}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
    set:html={iconMarkup[service.icon]}
  />
  <h3 class="text-2xl font-semibold mb-4 text-heading">{service.title}</h3>
  <p class="text-muted-light mb-4">{service.description}</p>
  <ul class="text-left text-muted-light list-disc list-inside mt-auto">
    {service.items.map((item) => <li>{item}</li>)}
  </ul>
</article>

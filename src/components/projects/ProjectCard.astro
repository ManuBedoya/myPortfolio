---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Icon from '../icons/Icon.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, summary, image, imageAlt, stack, highlights, url } = project.data;
---

<article class="bg-gradient-to-br from-light-bg to-primary-dark rounded-xl overflow-hidden shadow-lg transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_8px_24px_rgba(142,36,170,0.35)] flex flex-col">
    <Image
        src={image}
        alt={imageAlt}
        widths={[400, 800]}
        sizes="(min-width: 768px) 480px, 100vw"
        class="w-full aspect-[1200/630] object-cover"
    />
    <div class="p-6 flex flex-col flex-grow">
        <h3 class="text-2xl font-bold mb-2 text-heading">{title}</h3>
        <p class="text-muted-light mb-4">{summary}</p>
        <ul class="flex flex-wrap gap-2 mb-4" aria-label="Tecnologías">
            {stack.map((tech) => (
                <li class="px-3 py-1 bg-violet-deep text-white rounded-full text-sm font-medium">{tech}</li>
            ))}
        </ul>
        {highlights.length > 0 && (
            <ul class="list-disc list-inside text-light-text text-sm space-y-1 mb-6">
                {highlights.slice(0, 3).map((item) => <li>{item}</li>)}
            </ul>
        )}
        <div class="mt-auto flex flex-wrap gap-3">
            <a
                href={`/proyectos/${project.id}/`}
                class="inline-flex items-center gap-2 bg-gradient-to-r from-violet-mid to-violet-deep text-white py-2 px-5 rounded-lg text-sm font-semibold shadow-lg transition-all duration-300 ease-in-out hover:opacity-90 hover:translate-y-[-2px]"
            >
                <Icon name="arrow-right" class="size-[1em]" />
                Ver caso<span class="sr-only"> de {title}</span>
            </a>
            <a
                href={url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 border border-heading/60 text-heading py-2 px-5 rounded-lg text-sm font-semibold transition-colors duration-300 hover:bg-heading/10"
            >
                Ver sitio<span class="sr-only"> de {title} (se abre en una pestaña nueva)</span>
            </a>
        </div>
    </div>
</article>

---
import "../styles/global.css";
import '@fontsource-variable/inter';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Portafolio de Manuel Bedoya - Desarrollador Full Stack">
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script is:inline>document.documentElement.classList.add('js');</script>
	</head>
	<body class="bg-primary-dark text-white font-sans">
		<div class="absolute inset-0 -z-10 h-full w-full items-center [background:radial-gradient(125%_125%_at_50%_10%,#000_40%,#63e_100%)]"></div>
		<slot/>
		<script>
			// Reveal sections once as they enter the viewport.
			const sections = document.querySelectorAll('.fade-in-section');

			const Observer = window.IntersectionObserver;

			if (Observer) {
				const observer = new Observer((entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							entry.target.classList.add('is-visible');
							observer.unobserve(entry.target);
						}
					});
				}, { threshold: 0, rootMargin: '0px 0px -10% 0px' });

				sections.forEach((section) => observer.observe(section));
			} else {
				// Without observer support, show everything immediately.
				sections.forEach((section) => section.classList.add('is-visible'));
			}
		</script>
	</body>
</html>

<style is:global>
	:root {
		--accent: 136, 58, 234;
		--accent-light: 224, 204, 250;
		--accent-dark: 49, 10, 101;
		--accent-gradient: linear-gradient(45deg, rgb(var(--accent)), rgb(var(--accent-light)) 30%, white 60%);
	}
	html {
		font-family: var(--font-sans);
		background: #1a1a1a;
		background-size: 224px;
	}
	code {
		font-family: Menlo, Monaco, Lucida Console, Liberation Mono, DejaVu Sans Mono,
			Bitstream Vera Sans Mono, Courier New, monospace;
	}
</style>
---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/icons/Icon.astro';

export const getStaticPaths = (async () => {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}) satisfies GetStaticPaths;

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, summary, image, imageAlt, stack, highlights, url } = project.data;
const { Content } = await render(project);
// JPEG at the recommended 1200px width keeps link previews compatible with every platform.
const socialImage = await getImage({ src: image, width: 1200, format: 'jpg' });
---

<Layout
  title={`${title} - Caso de estudio | Manuel Bedoya`}
  description={summary}
  image={socialImage.src}
  imageAlt={imageAlt}
  type="article"
>
  <Header />
  <main class="py-12 md:py-16">
    <article class="container mx-auto px-4 max-w-4xl">
      <a
        href="/#projects"
        class="inline-flex items-center gap-2 text-sm text-muted-light hover:text-heading transition-colors mb-8"
      >
        <Icon name="arrow-right" class="size-[1em] rotate-180" />
        Volver a proyectos
      </a>

      <header class="mb-8">
        <p class="text-sm uppercase tracking-wider text-accent-green font-semibold mb-2">Caso de estudio</p>
        <h1 class="text-4xl md:text-5xl font-bold text-heading mb-4">{title}</h1>
        <p class="text-lg md:text-xl text-light-text">{summary}</p>
      </header>

      <Image
        src={image}
        alt={imageAlt}
        widths={[480, 896, 1200]}
        sizes="(min-width: 896px) 896px, 100vw"
        loading="eager"
        fetchpriority="high"
        class="w-full aspect-[1200/630] object-cover rounded-xl shadow-lg mb-10"
      />

      <div class="grid gap-10 md:grid-cols-[1fr_16rem]">
        <div class="case-study-prose">
          <Content />
        </div>

        <aside class="space-y-8">
          <section>
            <h2 class="text-lg font-semibold text-heading mb-3">Tecnologías</h2>
            <ul class="flex flex-wrap gap-2">
              {stack.map((tech) => (
                <li class="px-3 py-1 bg-violet-deep text-white rounded-full text-sm font-medium">{tech}</li>
              ))}
            </ul>
          </section>

          {highlights.length > 0 && (
            <section>
              <h2 class="text-lg font-semibold text-heading mb-3">Aspectos destacados</h2>
              <ul class="list-disc pl-5 space-y-2 text-light-text text-sm">
                {highlights.map((item) => <li>{item}</li>)}
              </ul>
            </section>
          )}

          <a
            href={url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-gradient-to-r from-violet-mid to-violet-deep text-white py-2.5 px-5 rounded-lg text-sm font-semibold shadow-lg transition-all duration-300 hover:opacity-90"
          >
            Ver sitio en vivo<span class="sr-only"> (se abre en una pestaña nueva)</span>
            <Icon name="arrow-right" class="size-[1em]" />
          </a>
        </aside>
      </div>
    </article>
  </main>
  <Footer />
</Layout>

<style>
  /* Minimal readable typography for the rendered Markdown body. */
  .case-study-prose {
    color: var(--color-light-text);
    font-size: 1.0625rem;
    line-height: 1.75;
    max-width: 65ch;
  }

  .case-study-prose :global(h2) {
    color: var(--color-heading);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 2.25rem 0 0.75rem;
  }

  .case-study-prose :global(h2:first-child) {
    margin-top: 0;
  }

  .case-study-prose :global(h3) {
    color: var(--color-heading);
    font-size: 1.25rem;
    font-weight: 600;
    margin: 1.75rem 0 0.5rem;
  }

  .case-study-prose :global(p) {
    margin: 0 0 1.25rem;
  }

  .case-study-prose :global(ul),
  .case-study-prose :global(ol) {
    margin: 0 0 1.25rem;
    padding-left: 1.5rem;
  }

  .case-study-prose :global(ul) {
    list-style: disc;
  }

  .case-study-prose :global(ol) {
    list-style: decimal;
  }

  .case-study-prose :global(li) {
    margin-bottom: 0.5rem;
  }

  .case-study-prose :global(strong) {
    color: #fff;
    font-weight: 600;
  }

  .case-study-prose :global(a) {
    color: var(--color-heading);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
